# GENERATE A RANDOM SECRET, for example: openssl rand -base64 48
# Required by Next.js. Use at least 32 bytes; never commit the generated value.
SESSION_SECRET=

# Vehicle cascade selection
VEHICLE_PROVIDER=autoways
FALLBACK_PROVIDER=matriculapt

# Auto Ways (AUTOWAYS_API_TOKEN is also accepted for backwards compatibility)
AUTOWAYS_API_KEY=
AUTOWAYS_BASE_URL=https://app.auto-ways.net/api/v1
AUTOWAYS_PLATE_PATH=/pt
AUTOWAYS_VIN_PATH=/vin/

# TIPS4Y contract-specific paths
TIPS4Y_API_KEY=
TIPS4Y_BASE_URL=
TIPS4Y_PLATE_PATH=
TIPS4Y_VIN_PATH=

# Matricula.co.pt
MATRICULAPT_USERNAME=
MATRICULAPT_ENDPOINT=https://www.matricula.co.pt/api/reg.asmx/CheckPortugal

# TelePeças contract/OAuth
TELEPECAS_ACCESS_TOKEN=
TELEPECAS_CLIENT_ID=
TELEPECAS_CLIENT_SECRET=
TELEPECAS_TOKEN_URL=
TELEPECAS_BASE_URL=https://api.telepecas.com/v1
TELEPECAS_PLATE_PATH=
TELEPECAS_VIN_PATH=

# TecAlliance placeholder until contract paths are known
TECALLIANCE_API_KEY=
TECALLIANCE_BASE_URL=
TECALLIANCE_PLATE_PATH=
TECALLIANCE_VIN_PATH=
