# Provider selection: business logic reads only these names.
VEHICLE_PROVIDER=autoways
FALLBACK_PROVIDER=matriculapt
CATALOGUE_VEHICLE_PROVIDER=tecdoc
FITMENT_PROVIDER=tecdoc
INVENTORY_PROVIDER=primavera
SUPPLIER_PROVIDER=none
ERP_PROVIDER=primavera

# Autoways / AUTO-NOW (documented paths; never commit a token)
AUTOWAYS_API_TOKEN=
AUTOWAYS_BASE_URL=https://app.auto-ways.net/api/v1
AUTOWAYS_PLATE_PATH=/pt
AUTOWAYS_VIN_PATH=/vin/

# TIPS4Y: copy the contracted endpoint paths exactly when supplied.
TIPS4Y_API_KEY=
TIPS4Y_BASE_URL=
TIPS4Y_PLATE_PATH=
TIPS4Y_VIN_PATH=

# Matricula.co.pt advertised free-test username.
MATRICULAPT_USERNAME=
MATRICULAPT_ENDPOINT=https://www.matricula.co.pt/api/reg.asmx/CheckPortugal

# TelePeças: endpoint paths and OAuth URL must come from the integrator contract.
TELEPECAS_ACCESS_TOKEN=
TELEPECAS_CLIENT_ID=
TELEPECAS_CLIENT_SECRET=
TELEPECAS_TOKEN_URL=
TELEPECAS_BASE_URL=https://api.telepecas.com/v1
TELEPECAS_PLATE_PATH=
TELEPECAS_VIN_PATH=

# TecAlliance: exact products/paths depend on the purchased licence.
TECALLIANCE_API_KEY=
TECALLIANCE_BASE_URL=
TECALLIANCE_PLATE_PATH=
TECALLIANCE_VIN_PATH=

# Primavera/Cegid: populate only after inspecting version/modules/API.
PRIMAVERA_BASE_URL=
PRIMAVERA_API_KEY=
