{"openapi":"3.0.1","info":{"title":"VIN-DECODER","description":"The Web Service API allows you to query the official database in real time by simply entering a VIN. You allow your ecosystem to identify vehicles in Germany, Austria, Belgium, Spain, France, Italy and Portugal with one click. The API also allows you to identify and obtain an identifier such as type K for auto parts compatibility with the TecDoc catalog.","termsOfService":"https://auto-ways.net/","contact":{"email":"contact@auto-ways.net"},"version":"1.0.0"},"servers":[{"url":"https://app.auto-ways.net/api/v1"}],"tags":[{"name":"Auto-Now","description":"Identify vehicul.","externalDocs":{"description":"Find more info","url":"https://auto-ways.net/api-doc"}}],"paths":{"/vin/":{"get":{"tags":["Auto-Now"],"summary":"Find car by VIN","description":"Return vehicle data from license plate","operationId":"getCarByVIN","parameters":[{"name":"vin","in":"query","description":" Your VIN (Vehicle Identification Number)","required":true,"schema":{"type":"string","default":"VF1R9800962986572"}},{"name":"output_lang","in":"query","description":"Define the API output language (fr,en)","required":false,"schema":{"type":"string","default":"en"}},{"name":"country","in":"query","description":"Define vehicles country code ex: (FR,DE,AT,BE,ES,IT,PT )","required":false,"schema":{"type":"string","default":"FR"}},{"name":"token","in":"query","description":"Your token","required":true,"schema":{"type":"string","default":"4a486e221ea6d4a888671242b5fe0fed"}}],"responses":{"200":{"description":"success","content":{"application/json":{"example":{"error":false,"data":{"AWN_immat":"fh034dd","AWN_VIN":"VF1R9800962986572","AWN_marque":"RENAULT","AWN_modele":"CLIO IV","AWN_modele_etude":"CLIO IV","AWN_version":"IV DCI","AWN_type_mine":"M10RENVP603P733","AWN_k_type":"57281","AWN_couleur":"GRIS","AWN_Hauteur":"145","AWN_largeur":"173","AWN_longueur":"406","AWN_marque_carrosserie":"RENAULT","AWN_poids_vide":"1160","AWN_puissance_chevaux":"9