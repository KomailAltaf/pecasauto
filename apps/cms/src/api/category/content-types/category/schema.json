{
  "kind": "collectionType",
  "collectionName": "categories",
  "info": { "singularName": "category", "pluralName": "categories", "displayName": "Category" },
  "options": { "draftAndPublish": true },
  "attributes": {
    "name": { "type": "string", "required": true },
    "slug": { "type": "uid", "targetField": "name", "required": true, "unique": true },
    "description": { "type": "text" },
    "image": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "products": { "type": "relation", "relation": "oneToMany", "target": "api::product-editorial.product-editorial", "mappedBy": "category" },
    "seo": { "type": "component", "repeatable": false, "component": "shared.seo" }
  }
}
